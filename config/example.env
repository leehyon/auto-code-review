# AI代码审查项目 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ==================== 大模型供应商配置 ====================
# 支持的值: openai, deepseek, qwen, github_copilot
LLM_PROVIDER=deepseek

# ==================== DeepSeek配置 ====================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_MODEL=deepseek-chat

# ==================== OpenAI配置 ====================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE_URL=https://api.openai.com
# OPENAI_API_MODEL=gpt-4

# ==================== 通义千问配置 ====================
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com
# QWEN_API_MODEL=qwen-turbo

# ==================== GitHub Copilot 配置 ====================
# GITHUB_COPILOT_TOKEN=your_github_token_here
# GITHUB_COPILOT_MODEL=gpt-6-luna
# API 形态：responses（默认，部分模型只支持这个）或 chat_completions
# GITHUB_COPILOT_API_MODE=responses
# 可选，不配则自动查询该订阅对应的 endpoint
# GITHUB_COPILOT_API_BASE_URL=https://api.githubcopilot.com

# ==================== 代码审查配置 ====================
# 审查风格: professional, sarcastic, gentle, humorous
REVIEW_STYLE=professional

# 发送给大模型的最大token数量（影响审查详细程度）
REVIEW_MAX_TOKENS=15000

# 支持审查的文件扩展名
SUPPORTED_EXTENSIONS=.java,.py,.php,.yml,.vue,.go,.c,.cpp,.h,.js,.css,.md,.sql,.ts,.jsx,.tsx

# ==================== 功能开关 ====================
# 是否启用Push事件审查
PUSH_REVIEW_ENABLED=1

# 是否仅对受保护分支进行Merge Request审查
MERGE_REVIEW_ONLY_PROTECTED_BRANCHES_ENABLED=0

# ==================== GitLab配置 ====================
GITLAB_ACCESS_TOKEN=your_gitlab_access_token_here
GITLAB_URL=https://your-gitlab-instance.com

# ==================== GitHub配置 ====================
# GITHUB_ACCESS_TOKEN=your_github_access_token_here
# GITHUB_URL=https://api.github.com

# ==================== Bitbucket Server/Data Center配置 ====================
# Bitbucket 实例地址（自建部署），例如 https://bitbucket.example.com
# BITBUCKET_URL=https://bitbucket.example.com
# HTTP access token（个人 token 与项目/仓库级 token 通用）
#   个人 token  : 头像 -> Manage account -> HTTP access tokens
#   项目/仓库级  : Project / Repository settings -> HTTP access tokens（需 Data Center license）
# BITBUCKET_ACCESS_TOKEN=your_bitbucket_access_token_here
# Webhook Secret（可选但强烈建议配置），与 Bitbucket webhook 设置里的 Secret 保持一致
# BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret
# 是否校验自建实例的 SSL 证书（自签证书场景默认关闭）
# BITBUCKET_VERIFY_SSL=0
# REST API 前缀，默认 /rest/api/1.0（可改为 /rest/api/latest）
# BITBUCKET_API_PATH=/rest/api/1.0
# 仓库级指令文件（可选，逗号分隔多个）。读到的内容会作为「项目约定」提供给模型，
# 让审查按你们的规范提意见，例如 AGENTS.md、CONTRIBUTING.md、docs/convention.md。
# 从 PR 的目标分支读取（有界），文件不存在会跳过，不会导致审查失败。
# BITBUCKET_REPO_CONTEXT_FILES=AGENTS.md
# BITBUCKET_REPO_CONTEXT_MAX_LINES=200
# BITBUCKET_REPO_CONTEXT_MAX_BYTES=20000

# ==================== Gitea配置 ====================
# GITEA_ACCESS_TOKEN=your_gitea_access_token_here
# GITEA_URL=https://your-gitea-instance.com
# GITEA_WEBHOOK_SECRET=your_webhook_secret_here（可选，用于签名验证）

# Gitea Issue 模式配置
# 是否使用 Issue 模式存储审核结果（1=启用，0=禁用，默认启用）
# Issue 模式会将审核结果写入 Gitea Issue 而不是直接在 PR/Commit 上评论
# 优势：可审计、可追踪、可统计，支持工单化管理
GITEA_USE_ISSUE_MODE=1

# Issue 标签（可选，需要先在 Gitea 中创建标签）
# 多个标签用逗号分隔，例如：ai-review,code-review
# 默认禁用，如需启用请取消注释并配置标签名称
# GITEA_REVIEW_ISSUE_LABELS=ai-review,code-review

# ==================== 消息推送配置 ====================
# 钉钉推送配置
DINGTALK_ENABLED=1
DINGTALK_WEBHOOK_URL=your_dingtalk_webhook_url_here

# 企业微信推送配置
# WECOM_ENABLED=1
# WECOM_WEBHOOK_URL=your_wecom_webhook_url_here

# 飞书推送配置
# FEISHU_ENABLED=1
# FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here

# ==================== 详细审查模式配置 ====================
# 启用智能语言检测（自动选择最适合的审查提示词）
ENABLE_LANGUAGE_DETECTION=1

# 启用详细审查报告（包含代码示例和改进建议）
ENABLE_DETAILED_REVIEW=1

# 审查报告包含的维度（用逗号分隔）
# 可选值: code_quality, security, performance, error_handling, maintainability
REVIEW_DIMENSIONS=code_quality,security,performance,error_handling,maintainability

# 问题优先级过滤（只显示指定优先级以上的问题）
# 可选值: high, medium, low
MIN_ISSUE_PRIORITY=low

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/code_review.log

# ==================== 数据库配置 ====================
# 数据库类型: sqlite 或 mysql (默认: sqlite)
DB_TYPE=sqlite

# SQLite配置（当DB_TYPE=sqlite时生效）
# SQLite数据库文件路径
DB_FILE=data/data.db

# MySQL配置（当DB_TYPE=mysql时生效）
# MySQL主机地址
DB_HOST=192.168.12.56
# MySQL端口
DB_PORT=3306
# MySQL用户名
DB_USER=aireview
# MySQL密码
DB_PASSWORD=aireview123.
# MySQL数据库名
DB_NAME=pzds_aireview

# ==================== 性能配置 ====================
# 并发处理数量
MAX_CONCURRENT_REVIEWS=5

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# ==================== 安全配置 ====================
# 是否启用API密钥脱敏显示
ENABLE_TOKEN_MASKING=1

# Webhook签名验证密钥（可选）
WEBHOOK_SECRET=your_webhook_secret_here
