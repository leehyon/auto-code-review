# ==========================================================================
#  AI 代码审查服务 —— 环境变量配置
#
#  用法：cp config/example.env config/.env，按需修改后重启服务生效
#
#  标记说明：
#    [必填]  必须配置，缺了对应功能起不来
#    [选填]  有默认值，不配也能跑
#    [选一]  几选一，按你的实际情况只配一个
#
#  配置顺序：先定 1、2 两块（大模型 + 平台），3~6 块按需调。
# ==========================================================================


# ==========================================================================
# 1. 大模型供应商
# ==========================================================================

# [必填] 实际使用的供应商：openai / deepseek / qwen / github_copilot
LLM_PROVIDER=deepseek

# 下面按供应商填。只用一个供应商就只填对应那段，其余保持注释。
# 多个都填了没关系，LLM_PROVIDER 决定实际用哪个。

# ---- DeepSeek ----
# [必填] API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# [选填] 接口地址
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# [选填] 模型名
DEEPSEEK_API_MODEL=deepseek-chat

# ---- OpenAI ----
# [必填] API Key
# OPENAI_API_KEY=your_openai_api_key_here
# [选填] 接口地址
# OPENAI_API_BASE_URL=https://api.openai.com
# [选填] 模型名
# OPENAI_API_MODEL=gpt-4

# ---- 通义千问 ----
# [必填] API Key
# QWEN_API_KEY=your_qwen_api_key_here
# [选填] 接口地址
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com
# [选填] 模型名
# QWEN_API_MODEL=qwen-turbo

# ---- GitHub Copilot ----
# [必填] GitHub token，ghp_ / gho_ / github_pat_ 开头都可以
# GITHUB_COPILOT_TOKEN=your_github_token_here
# [选填] 模型名。gpt-6-luna 只支持 Responses API
# GITHUB_COPILOT_MODEL=gpt-6-luna
# [选填] API 形态：responses（默认）或 chat_completions
# GITHUB_COPILOT_API_MODE=responses
# [选填] endpoint。不配会自动按订阅类型查询（business 账号是 api.business.githubcopilot.com）
# GITHUB_COPILOT_API_BASE_URL=https://api.githubcopilot.com


# ==========================================================================
# 2. 代码托管平台  [选一]
#    仓库在哪个平台就配哪一段，其余整段保持注释。
# ==========================================================================

# ---- GitLab ----
# [必填] Access Token 与实例地址
# GITLAB_ACCESS_TOKEN=your_gitlab_access_token_here
# GITLAB_URL=https://your-gitlab-instance.com

# ---- GitHub ----
# [必填] Access Token
# GITHUB_ACCESS_TOKEN=your_github_access_token_here
# [选填] API 地址
# GITHUB_URL=https://api.github.com

# ---- Gitea ----
# [必填] Access Token 与实例地址
# GITEA_ACCESS_TOKEN=your_gitea_access_token_here
# GITEA_URL=https://your-gitea-instance.com
# [选填] Issue 模式：审查结果写成 Gitea Issue 而不是直接评论在 PR/Commit 上。
#        可审计、可追踪、支持工单化管理。0 = 直接评论
GITEA_USE_ISSUE_MODE=1
# [选填] Issue 标签，需先在 Gitea 里创建好。留空 = 不打标签
# GITEA_REVIEW_ISSUE_LABELS=ai-review,code-review

# ---- Bitbucket Server / Data Center ----
# [必填] 实例地址（自建部署）
# BITBUCKET_URL=https://bitbucket.example.com
# [必填] HTTP access token。只用 Bearer 认证，不需要用户名
#   个人 token   : 头像 -> Manage account -> HTTP access tokens
#   项目/仓库级  : Project / Repository settings -> HTTP access tokens（需 Data Center license）
# BITBUCKET_ACCESS_TOKEN=your_bitbucket_access_token_here
# [选填] Webhook Secret，与 Bitbucket webhook 设置里的 Secret 保持一致。强烈建议配置：
#        不配的话任何知道 webhook 地址的人都能伪造请求触发审查
# BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret
# [选填] 是否校验自建实例的 SSL 证书（自签证书默认不校验）
# BITBUCKET_VERIFY_SSL=0
# [选填] REST API 前缀
# BITBUCKET_API_PATH=/rest/api/1.0
# [选填] GitHub Copilot 请求超时（秒）。默认 180。
#        模型在 Responses API 上是非流式请求，超时按「整个响应未在时限内返回」算，
#        慢响应时调大有用
# GITHUB_COPILOT_TIMEOUT=180
# [选填] 超时/网络错误自动重试次数。默认 1
# GITHUB_COPILOT_MAX_RETRIES=1
# [选填] 重试前等待秒数。默认 5
# GITHUB_COPILOT_RETRY_BACKOFF=5
# [选填] 读取仓库级约定文件（AGENTS.md 等），作为审查依据注入提示词。
#        从 PR 的目标分支读取（有界），文件不存在会跳过，不会导致审查失败。
# [选填] 开关。0 = 完全关闭：不发请求，也不占任何上下文
# BITBUCKET_REPO_CONTEXT_ENABLED=1
# [选填] 所有项目默认读哪些约定文件，逗号分隔。
#        留空 = 自动发现：AGENTS.md / CLAUDE.md / .github/copilot-instructions.md
#        / .cursorrules / .clinerules / .windsurfrules / GEMINI.md（命中即停），
#        都没有时才回落到 CONTRIBUTING.md / README.md。
#        填了就只读指定文件，全部读取
# BITBUCKET_REPO_CONTEXT_FILES=
# [选填] 给单个项目指定规则在仓库里的位置，格式 PROJECT_KEY:path1,path2
#        多个项目用分号分隔，例如 ICCC:docs/rules.md;EMS-SW:AGENTS.md
#        命中该项目的条目时优先于上面的全局清单
# BITBUCKET_REPO_CONTEXT_PROJECT_FILES=
# [选填] 读到的约定内容的行数上限和字节数上限
# BITBUCKET_REPO_CONTEXT_MAX_LINES=200
# BITBUCKET_REPO_CONTEXT_MAX_BYTES=20000


# ==========================================================================
# 3. 审查行为
# ==========================================================================

# [选填] 审查风格：professional / concise / gentle
REVIEW_STYLE=professional

# [选填] 送进模型的 diff token 上限。超出部分按顺序截断，
#        预算不够时源码优先、生成的模型配置排在后面
REVIEW_MAX_TOKENS=100000

# [选填] 审查哪些文件类型。扩展名不在列表里的文件直接跳过（不报错、不发评论）
SUPPORTED_EXTENSIONS=.java,.py,.php,.yml,.vue,.go,.c,.cpp,.h,.js,.css,.md,.sql,.ts,.jsx,.tsx,.arxml

# [选填] 哪些扩展名算「生成类」，排在源码后面。留空 = 没有低优先级文件
REVIEW_LOW_PRIORITY_EXTENSIONS=.arxml,.xml

# [选填] 是否审查 Push 事件
PUSH_REVIEW_ENABLED=1

# [选填] 是否只审查受保护分支的 Merge Request
MERGE_REVIEW_ONLY_PROTECTED_BRANCHES_ENABLED=0

# [选填] 评论里要 @ 提醒的用户，逗号分隔。比如 bob,alice 留空 = 不提醒任何人
REVIEW_MENTION_USERS=


# ==========================================================================
# 4. 消息推送  [可都不配]
#    除了写进 PR/Commit 评论，审查结果还能推送到 IM。
# ==========================================================================

# ---- 钉钉 ----
# [选填] 推送开关与地址
# DINGTALK_ENABLED=1
# DINGTALK_WEBHOOK_URL=your_dingtalk_webhook_url_here

# ---- 企业微信 ----
# [选填] 推送开关与地址
# WECOM_ENABLED=1
# WECOM_WEBHOOK_URL=your_wecom_webhook_url_here

# ---- 飞书 ----
# [选填] 推送开关与地址
# FEISHU_ENABLED=1
# FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here


# ==========================================================================
# 5. 日志
# ==========================================================================

# [选填] 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# [选填] 日志文件路径（相对项目根目录）
LOG_FILE=logs/code_review.log


# ==========================================================================
# 6. 数据库  [选一]
# ==========================================================================

# [选填] 数据库类型：sqlite 或 mysql
DB_TYPE=sqlite

# ---- SQLite（DB_TYPE=sqlite 时生效）----
# [选填] 数据库文件路径
DB_FILE=data/data.db

# ---- MySQL（DB_TYPE=mysql 时生效）----
# [选填] 主机、端口、用户名、密码、库名
# DB_HOST=192.168.12.56
# DB_PORT=3306
# DB_USER=aireview
# DB_PASSWORD=your_mysql_password
# DB_NAME=pzds_aireview
