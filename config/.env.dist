#服务端口
SERVER_PORT=5001

#Timezone
TZ=Asia/Shanghai

#大模型供应商配置,支持 deepseek, openai,zhipuai,qwen,github_copilot 和 ollama
LLM_PROVIDER=deepseek

#DeepSeek settings
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_MODEL=deepseek-chat

#OpenAI settings
OPENAI_API_KEY=xxxx
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

#ZhipuAI settings
ZHIPUAI_API_KEY=xxxx
ZHIPUAI_API_MODEL=GLM-4-Flash

#Qwen settings
QWEN_API_KEY=sk-xxx
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_MODEL=qwen-coder-plus

#GitHub Copilot settings
# GitHub token（ghp_ / gho_ / github_pat_ 等开头），
# 程序会先尝试换短期 Copilot token，失败则自动回退到直接使用原始 token
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_MODEL=gpt-6-luna
# API 形态：responses（默认，部分模型只支持这个）或 chat_completions
GITHUB_COPILOT_API_MODE=responses
# 可选。不配的话自动向 GitHub 查询该订阅对应的 endpoint
#GITHUB_COPILOT_API_BASE_URL=https://api.githubcopilot.com

#OllaMA settings; 注意: 如果使用 Docker 部署，127.0.0.1 指向的是容器内部的地址。请将其替换为实际的 Ollama服务器IP地址。
#OLLAMA_API_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_MODEL=deepseek-r1:latest

#支持review的文件类型
SUPPORTED_EXTENSIONS=.c,.cc,.cpp,.css,.go,.h,.java,.js,.jsx,.ts,.tsx,.md,.php,.py,.sql,.vue,.yml,.arxml
#每次 Review 的最大 Token 限制（超出部分自动截断）
REVIEW_MAX_TOKENS=10000
#Review 风格选项：professional（专业） | sarcastic（毒舌） | gentle（温和） | humorous（幽默）
REVIEW_STYLE=professional

#钉钉配置
DINGTALK_ENABLED=0
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

#企业微信配置
WECOM_ENABLED=0
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

#飞书配置
FEISHU_ENABLED=0
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

#自定义webhook配置，使用场景：通过飞书发送应用消息可以实现Push评审通知到提交人，在自定义webhook里可以实现各种定制通知功能
#参数EXTRA_WEBHOOK_URL接收POST请求，data={ai_codereview_data: {}, webhook_data: {}}，ai_codereview_data为本系统通知的数据，webhook_data为原github、gitlab hook触发的数据
EXTRA_WEBHOOK_ENABLED=0
EXTRA_WEBHOOK_URL=https://xxx/xxx

#日志配置
LOG_FILE=log/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
LOG_LEVEL=DEBUG

#工作日报发送时间
REPORT_CRONTAB_EXPRESSION=0 18 * * 1-5

#Gitlab配置
#GITLAB_URL={YOUR_GITLAB_URL} #部分老版本Gitlab webhook不传递URL，需要开启此配置，示例：https://gitlab.example.com
#GITLAB_ACCESS_TOKEN={YOUR_GITLAB_ACCESS_TOKEN} #系统会优先使用此GITLAB_ACCESS_TOKEN，如果未配置，则使用Webhook 传递的Secret Token

#Github配置(如果使用 Github 作为代码托管平台，需要配置此项)
#GITHUB_ACCESS_TOKEN={YOUR_GITHUB_ACCESS_TOKEN}

#Bitbucket Server/Data Center 配置(如果使用 Bitbucket 自建实例作为代码托管平台，需要配置此项)
# Bitbucket 实例地址，例如 https://bitbucket.example.com 或 http://bitbucket.example.com:7990/bitbucket
#BITBUCKET_URL={YOUR_BITBUCKET_URL}
# HTTP access token（Bitbucket Server 7.0+ 支持）。有两种，都填到这个变量即可：
#   个人 token   : 头像 -> Manage account -> HTTP access tokens -> Create token
#                  绑定个人账号，可见范围是该用户可访问的所有仓库
#   项目/仓库级  : Project / Repository settings -> HTTP access tokens -> Create token
#                  不绑定用户，可见范围仅该项目/仓库（需要 Data Center license）
#BITBUCKET_ACCESS_TOKEN={YOUR_BITBUCKET_ACCESS_TOKEN}
# Webhook Secret（可选但强烈建议配置）。
# 在 Bitbucket webhook 设置里填写同一个 Secret，请求就会带上 X-Hub-Signature: sha256=<hex>，
# 系统会用它做 HMAC 校验，防止有人伪造 payload 触发审查。留空则不做签名校验。
#BITBUCKET_WEBHOOK_SECRET={YOUR_BITBUCKET_WEBHOOK_SECRET}
# 是否校验自建实例的 SSL 证书（自签证书场景默认关闭）
#BITBUCKET_VERIFY_SSL=0
# REST API 前缀，默认 /rest/api/1.0（可改为 /rest/api/latest）
#BITBUCKET_API_PATH=/rest/api/1.0
# 仓库级指令文件（可选，逗号分隔多个）。读到的内容会作为「项目约定」提供给模型，
# 让审查能按你们的规范来提意见，例如 AGENTS.md、CONTRIBUTING.md、docs/convention.md。
# 从 PR 的目标分支读取（有界），文件不存在会跳过，不会导致审查失败。
#BITBUCKET_REPO_CONTEXT_FILES=AGENTS.md
# 仓库级指令文件的行数上限和字节数上限
#BITBUCKET_REPO_CONTEXT_MAX_LINES=200
#BITBUCKET_REPO_CONTEXT_MAX_BYTES=20000

# 开启Push Review功能(如果不需要push事件触发Code Review，设置为0)
PUSH_REVIEW_ENABLED=1
# 开启Merge请求过滤，过滤仅当合并目标分支是受保护分支时才Review(开启此选项请确保仓库已配置受保护分支protected branches)
MERGE_REVIEW_ONLY_PROTECTED_BRANCHES_ENABLED=0
# 需要review的分支名称
MERGE_REVIEW_ONLY_BRANCH_NAME=''

# Dashboard登录用户名和密码
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# queue (async, rq)
QUEUE_DRIVER=async
# REDIS_HOST=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# gitlab domain slugged
WORKER_QUEUE=git_test_com



# ==================== 数据库配置 ====================
# 数据库类型: sqlite 或 mysql (默认: sqlite)
DB_TYPE=mysql

# SQLite配置（当DB_TYPE=sqlite时生效）
# SQLite数据库文件路径
DB_FILE=data/data.db

# MySQL配置（当DB_TYPE=mysql时生效）
# MySQL主机地址
DB_HOST=192.168.12.56
# MySQL端口
DB_PORT=3306
# MySQL用户名
DB_USER=aireview
# MySQL密码
DB_PASSWORD=aireview123.
# MySQL数据库名
DB_NAME=pzds_aireview
